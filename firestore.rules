rules_version = '2';

// Registrations live at /registrations/{email}: the form needs no sign-in, so anyone may create a document
// keyed by its lowercased email, once (a second submit is an update and is denied). Only admins may read, list or delete.
// Older documents at /registrations/{uid} came from the Google sign-in flow; that path stays until open pages reload.
// Keep the admin list in sync with src/lib/admins.js.
//
// Đăng ký lịch học (trang /lich): chỉ email có trong /students mới vào được, mỗi sinh viên chỉ đọc/ghi bản ghi của mình.
// /schedule/config giữ trạng thái (draft → open → closed → published) và các buổi; /schedule/classes giữ lớp.
// Sinh viên chỉ ghi ca đã chọn (availability) khi trạng thái là open, chỉ thấy lớp khi đã published; lớp của sinh viên là lớp của ca đã chọn.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email.lower() in [
        'phuonglhk@gmail.com',
        'nguyenquocan1010@gmail.com'
      ];
    }

    function isStudent() {
      return signedIn();
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Sinh viên nằm trong danh sách được đăng ký lịch (admin nhập vào /students)
    function isListed() {
      return signedIn() && exists(/databases/$(database)/documents/students/$(myEmail()));
    }

    function changedOk(d, keys) {
      return (!('name' in keys) || (d.name is string && d.name.size() > 0 && d.name.size() <= 80))
        && (!('studentId' in keys) || (d.studentId is string && d.studentId.matches('[A-Z]{2}[0-9]{6}')))
        && (!('major' in keys) || d.major in ['SE', 'AI', 'IA', 'IS', 'OTHER'])
        && (!('term' in keys) || (d.term is string && d.term.matches('[1-9]')))
        && (!('infoConfirmedAt' in keys) || d.infoConfirmedAt == request.time);
    }

    function scheduleStatus() {
      return get(/databases/$(database)/documents/schedule/config).data.status;
    }

    function validOpenRegistration(id, d) {
      let fields = ['name', 'email', 'major', 'term', 'pledge', 'lang', 'createdAt'];
      // studentId là tuỳ chọn ở đây để trang đã mở trước khi thêm ô MSSV vẫn gửi được; form mới luôn gửi kèm
      return d.keys().hasOnly(fields.concat(['studentId'])) && d.keys().hasAll(fields)
        && (!('studentId' in d) || (d.studentId is string && d.studentId.matches('[A-Z]{2}[0-9]{6}')))
        && d.email is string && d.email.size() <= 254
        && d.email == d.email.lower()
        && d.email.matches('[^@ /]+@[^@ /]+[.][^@ /]+')
        && id == d.email
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.major in ['SE', 'AI', 'IA', 'IS', 'OTHER']
        && d.term is string && d.term.matches('[1-9]')
        && d.pledge == true
        && d.lang in ['vi', 'en']
        && d.createdAt == request.time;
    }

    // Shape written by the old Google sign-in flow
    function validRegistration(d) {
      let fields = ['uid', 'name', 'email', 'studentId', 'major', 'term', 'pledge', 'lang', 'createdAt', 'updatedAt'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && d.uid == request.auth.uid
        && d.email == request.auth.token.email
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.studentId is string && d.studentId.matches('[A-Z]{2}[0-9]{6}')
        && d.major in ['SE', 'AI', 'IA', 'IS', 'OTHER']
        && d.term is string && d.term.matches('[1-9]')
        && d.pledge == true
        && d.lang in ['vi', 'en']
        && d.updatedAt == request.time;
    }

    match /registrations/{id} {
      allow get: if isAdmin() || (isStudent() && request.auth.uid == id);
      allow list: if isAdmin();
      allow create: if validOpenRegistration(id, request.resource.data)
        || (isStudent() && request.auth.uid == id
          && validRegistration(request.resource.data)
          && request.resource.data.createdAt == request.time);
      allow update: if isStudent() && request.auth.uid == id
        && validRegistration(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // Sinh viên chỉ được điền MSSV khi ô đó đang trống, không sửa được trường nào khác
    match /students/{email} {
      allow get: if isAdmin() || (signedIn() && myEmail() == email);
      allow list, create, delete: if isAdmin();
      // Sinh viên tự kiểm tra và sửa thông tin của mình (trang /lich, bước Kiểm tra thông tin).
      // Chỉ kiểm tra trường nào thực sự đổi, để dữ liệu cũ (vd. ngành trống) không chặn việc sửa trường khác.
      allow update: if isAdmin() || (signedIn() && myEmail() == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'studentId', 'major', 'term', 'infoConfirmedAt'])
        && changedOk(request.resource.data, request.resource.data.diff(resource.data).affectedKeys()));
    }

    match /schedule/{docId} {
      allow read: if isAdmin()
        || (docId == 'config' && isListed())
        || (docId == 'classes' && isListed() && scheduleStatus() == 'published');
      allow write: if isAdmin();
    }

    match /availability/{email} {
      allow get: if isAdmin() || (signedIn() && myEmail() == email);
      allow list, delete: if isAdmin();
      // Admin đặt ca thay sinh viên (mục Sinh viên trên /admin); sinh viên chỉ tự ghi khi đăng ký đang mở
      allow create, update: if isAdmin() || (isListed() && myEmail() == email
        && scheduleStatus() == 'open'
        && request.resource.data.keys().hasOnly(['sessionIds', 'updatedAt'])
        && request.resource.data.keys().hasAll(['sessionIds', 'updatedAt'])
        && request.resource.data.sessionIds is list
        && request.resource.data.sessionIds.size() <= 60
        && request.resource.data.updatedAt == request.time);
    }

    function myStudentClass() {
      return get(/databases/$(database)/documents/students/$(myEmail())).data.classId;
    }

    function validAttendanceResult(d) {
      let config = get(/databases/$(database)/documents/attendance/config).data;
      return d.gpsResult in ['inside', 'outside', 'poor_accuracy', 'unavailable']
        && ((d.gpsResult == 'inside' && d.status == 'present'
          && (d.accuracyMeters is int || d.accuracyMeters is float) && d.accuracyMeters <= config.accuracyThresholdMeters)
          || (d.gpsResult != 'inside' && d.status == 'rejected'))
        && (d.accuracyMeters == null || ((d.accuracyMeters is int || d.accuracyMeters is float) && d.accuracyMeters >= 0 && d.accuracyMeters <= 10000));
    }

    function validCurrentAttendanceQr(d) {
      let sessionPath = /databases/$(database)/documents/attendanceSessions/$(d.sessionId);
      let currentPath = /databases/$(database)/documents/attendance/current;
      return exists(sessionPath)
        && get(sessionPath).data.classId == myStudentClass()
        && exists(currentPath)
        && get(currentPath).data.active == true
        && get(currentPath).data.sessionId == d.sessionId
        && get(currentPath).data.classId == myStudentClass()
        && get(currentPath).data.currentToken == d.token
        && get(currentPath).data.tokenExpiresAt > request.time;
    }

    function validAdminAttendanceReview() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewReason', 'reviewedBy', 'reviewedAt', 'retryAllowed'])
        && request.resource.data.status in ['present', 'rejected', 'excused']
        && request.resource.data.reviewReason is string && request.resource.data.reviewReason.size() >= 5 && request.resource.data.reviewReason.size() <= 500
        && request.resource.data.reviewedBy == request.auth.token.email.lower()
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.retryAllowed == false;
    }

    function validAdminRetryGrant() {
      return resource.data.status == 'rejected'
        && resource.data.retryAllowed != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['retryAllowed', 'retryReason', 'retryAllowedBy', 'retryAllowedAt', 'attemptCount', 'retryHistory'])
        && request.resource.data.retryAllowed == true
        && request.resource.data.retryReason is string && request.resource.data.retryReason.size() >= 5 && request.resource.data.retryReason.size() <= 500
        && request.resource.data.retryAllowedBy == request.auth.token.email.lower()
        && request.resource.data.retryAllowedAt == request.time
        && request.resource.data.attemptCount is int && request.resource.data.attemptCount >= 1 && request.resource.data.attemptCount <= 50
        && request.resource.data.retryHistory is list && request.resource.data.retryHistory.size() >= 1 && request.resource.data.retryHistory.size() <= 50;
    }

    match /attendance/{docId} {
      allow get: if isAdmin() || (docId == 'config' && isListed())
        || (docId == 'current' && isListed()
          && (!exists(/databases/$(database)/documents/attendance/current)
            || resource.data.classId == myStudentClass()));
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /attendanceSessions/{sessionId} {
      allow get: if isAdmin() || (isListed() && resource.data.classId == myStudentClass());
      allow list: if isAdmin() || (isListed() && resource.data.classId == myStudentClass());
      allow create, update, delete: if isAdmin();
    }

    match /attendanceRecords/{recordId} {
      allow get: if isAdmin() || (isListed()
        && recordId.split('_').size() == 2 && recordId.split('_')[1] == myEmail());
      allow list: if isAdmin() || (isListed()
        && resource.data.classId == myStudentClass()
        && resource.data.studentEmail == myEmail());
      allow create: if isListed()
        && request.resource.data.keys().hasOnly(['sessionId', 'classId', 'studentEmail', 'studentName', 'status', 'gpsResult', 'accuracyMeters', 'token', 'submittedAt', 'attemptCount'])
        && request.resource.data.keys().hasAll(['sessionId', 'classId', 'studentEmail', 'studentName', 'status', 'gpsResult', 'accuracyMeters', 'token', 'submittedAt', 'attemptCount'])
        && request.resource.data.sessionId is string
        && request.resource.data.classId == myStudentClass()
        && request.resource.data.studentEmail == myEmail()
        && request.resource.data.studentName is string && request.resource.data.studentName.size() <= 120
        && request.resource.data.status in ['present', 'rejected']
        && validAttendanceResult(request.resource.data)
        && request.resource.data.attemptCount == 1
        && request.resource.data.token is string && request.resource.data.token.size() >= 16
        && request.resource.data.submittedAt == request.time
        && recordId == request.resource.data.sessionId + '_' + myEmail()
        && validCurrentAttendanceQr(request.resource.data);
      allow update: if (isAdmin() && validAdminAttendanceReview())
        || (isAdmin() && validAdminRetryGrant())
        || (isListed()
          && resource.data.retryAllowed == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'gpsResult', 'accuracyMeters', 'token', 'submittedAt', 'retryAllowed', 'attemptCount'])
          && request.resource.data.retryAllowed == false
          && request.resource.data.attemptCount == resource.data.attemptCount + 1
          && request.resource.data.attemptCount <= 50
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.classId == myStudentClass()
          && request.resource.data.studentEmail == myEmail()
          && request.resource.data.status in ['present', 'rejected']
          && validAttendanceResult(request.resource.data)
          && request.resource.data.token is string && request.resource.data.token.size() >= 16
          && request.resource.data.submittedAt == request.time
          && recordId == request.resource.data.sessionId + '_' + myEmail()
          && validCurrentAttendanceQr(request.resource.data));
      allow delete: if isAdmin();
    }
  }
}
