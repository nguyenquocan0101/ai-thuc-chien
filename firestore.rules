rules_version = '2';

// Registrations live at /registrations/{email}: the form needs no sign-in, so anyone may create a document
// keyed by its lowercased email, once (a second submit is an update and is denied). Only admins may read, list or delete.
// Older documents at /registrations/{uid} came from the Google sign-in flow; that path stays until open pages reload.
// Keep the admin list in sync with src/lib/admins.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email.lower() in [
        'phuonglhk@gmail.com',
        'nguyenquocan1010@gmail.com'
      ];
    }

    function isStudent() {
      return signedIn();
    }

    function validOpenRegistration(id, d) {
      let fields = ['name', 'email', 'major', 'term', 'pledge', 'lang', 'createdAt'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && d.email is string && d.email.size() <= 254
        && d.email == d.email.lower()
        && d.email.matches('[^@ /]+@[^@ /]+[.][^@ /]+')
        && id == d.email
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.major in ['SE', 'AI', 'IA', 'IS', 'OTHER']
        && d.term is string && d.term.matches('[1-9]')
        && d.pledge == true
        && d.lang in ['vi', 'en']
        && d.createdAt == request.time;
    }

    // Shape written by the old Google sign-in flow
    function validRegistration(d) {
      let fields = ['uid', 'name', 'email', 'studentId', 'major', 'term', 'pledge', 'lang', 'createdAt', 'updatedAt'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && d.uid == request.auth.uid
        && d.email == request.auth.token.email
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.studentId is string && d.studentId.matches('[A-Z]{2}[0-9]{6}')
        && d.major in ['SE', 'AI', 'IA', 'IS', 'OTHER']
        && d.term is string && d.term.matches('[1-9]')
        && d.pledge == true
        && d.lang in ['vi', 'en']
        && d.updatedAt == request.time;
    }

    match /registrations/{id} {
      allow get: if isAdmin() || (isStudent() && request.auth.uid == id);
      allow list: if isAdmin();
      allow create: if validOpenRegistration(id, request.resource.data)
        || (isStudent() && request.auth.uid == id
          && validRegistration(request.resource.data)
          && request.resource.data.createdAt == request.time);
      allow update: if isStudent() && request.auth.uid == id
        && validRegistration(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }
  }
}
