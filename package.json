{
  "name": "ai-thuc-chien",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 192.168.1.3",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore --import=./.emulator-data --export-on-exit=./.emulator-data",
    "emulators:lan": "firebase emulators:start --config firebase.lan.json --only auth,firestore --import=./.emulator-data --export-on-exit=./.emulator-data",
    "seed:emulator": "node tools/firestore-seed.mjs",
    "seed:emulator:lan": "node tools/firestore-seed.mjs firebase.lan.json",
    "deploy:rules": "npx -y firebase-tools deploy --only firestore"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "firebase": "^13.2.0",
    "mapbox-gl": "^3.36.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "vite": "^8.3.7"
  }
}
